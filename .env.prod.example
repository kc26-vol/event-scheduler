# .env.prod のテンプレート。
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# して値を埋めてください。.env.prod は .gitignore 済みです (本番シークレットを含むため)。
#
# 既に Azure 側に設定がある場合は、次のコマンドで現在値を確認できます:
#   az webapp config appsettings list -n <アプリ名> -g <RG名> -o table

# --- デプロイ先 ---
AZURE_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=kcjp26-event-scheduler-dev
AZURE_WEBAPP_NAME=kcjp26-event-scheduler-dev-app

# --- アプリ設定 ---
# make deploy では反映されません。反映したいときだけ make sync-settings を実行します。
APP_PASSWORD=
SESSION_SECRET=
RESET_PASSWORD=
# /home 配下は永続ストレージ。デプロイしてもデータが消えません。
DATA_DIR=/home/data
TZ=Asia/Tokyo
SCM_DO_BUILD_DURING_DEPLOYMENT=true

# /home を永続ストレージとしてマウントする。
# 組み込みイメージでは既定で永続だが、カスタムコンテナでは既定が false であり、
# デプロイツールがこの値を false に書き換える事象も報告されているため明示する。
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true
WEBSITE_HTTPLOGGING_RETENTION_DAYS=3

# DATA_DIR を設定していると、起動時に /home のマウント完了を待つガードが自動で働く
# (未マウントのまま「空のDB」を作ってしまう事故を防ぐため)。追加の設定は不要。
#
# ボリュームが空の初回デプロイ時だけ、下を一時的に 1 にする。通常は設定しない。
# ALLOW_EMPTY_DATA_DIR=1