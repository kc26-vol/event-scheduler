__pycache__/
*.pyc
*.db
.venv/
venv/
uploads/
node_modules/
frontend/dist/

# デプロイ設定 (シークレットを含む。コミット厳禁)
# 環境ごとに .env.prod / .env.staging を置くため、個別列挙ではなくパターンで弾く。
# (列挙だと新しい環境を足したときに漏れる)
.env
.env.*
!.env.*.example

# make deploy の中間生成物
.deploy/

# 本番バックアップ (実データを含む。コミット厳禁)
backups/

# Terraform (state と本番シークレットを含む。コミット厳禁)
# 深さに依存しないパターンにする (state は infra/envs/<env>/ 配下に作られるため)
**/terraform.tfvars
**/.terraform/
**/.terraform.lock.hcl
# state には全シークレットが平文で入る。絶対にコミットしないこと
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# macOS
.DS_Store
